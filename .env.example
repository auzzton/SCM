# ============================================================
# SCM Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ─── Database (override for Docker / production) ───────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/scm_dev
SPRING_DATASOURCE_USERNAME=scm_admin
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# ─── JWT ───────────────────────────────────────────────────
# Generate a secure 256-bit hex key:
#   openssl rand -hex 32
JWT_SECRET=replace_with_a_256_bit_hex_secret
JWT_EXPIRATION_MS=86400000

# ─── Kafka ─────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Next.js Frontend ──────────────────────────────────────
# Points to the API Gateway (or direct server in dev)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ─── AWS (used in CI/CD and production deployments) ────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
EKS_CLUSTER_NAME=scm-cluster
